---
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Skills from '../components/Skills.astro';
import Experience from '../components/Experience.astro';
import Education from '../components/Education.astro';
import Footer from '../components/Footer.astro';

import data from '../data/cv_data.json';
import '../styles/global.css';
---

<!doctype html>
<html lang='en'>
  <head>
    <meta charset='UTF-8' />
    <meta name='viewport' content='width=device-width' />
    <meta name='description' content={`${data.name} - ${data.title}`} />
    <title>{data.name} - Portfolio</title>
  </head>

  <body>
    <Header />
    <main>
      <Hero name={data.name} about={data.about} hobbies={data.hobbies} />
      <Skills skills={data.skills} />
      <Experience experience={data.experience} />
      <Education education={data.education} />
      <Footer title='Social Media' navlinkId='social' socials={data.socials} />
    </main>
  </body>
</html>
