---
import SocialLink from './SocialLink.astro';

interface Social {
  url: string;
  img: string;
  alt: string;
}

interface Props {
  title: string;
  navlinkId: string;
  socials: Record<string, Social>;
}

const { title, navlinkId, socials } = Astro.props;
---

<footer class='footer-section' id={navlinkId}>
  <h2>{title}</h2>
  <div class='nav-links'>
    {
      Object.entries(socials).map(([key, data]) => (
        <SocialLink
          url={data.url}
          img={data.img}
          alt={data.alt}
          label={key.charAt(0).toUpperCase() + key.slice(1)}
        />
      ))
    }
  </div>
</footer>
