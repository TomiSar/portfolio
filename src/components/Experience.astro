---
interface Experience {
  company: string;
  role: string;
  period: string;
  projects?: string;
  description: string;
}

interface Props {
  experience: Experience[];
}

const { experience } = Astro.props;
---

<section class='section experience-section' id='experience'>
  <h2>Work Experience</h2>
  <a
    href='/Tomi_Sarjamo_CV.pdf'
    download='Tomi_Sarjamo_CV.pdf'
    class='download-cv-btn'
  >
    <svg
      xmlns='http://w3.org'
      width='18'
      height='18'
      viewBox='0 0 24 24'
      fill='none'
      stroke='currentColor'
      stroke-width='2'
      stroke-linecap='round'
      stroke-linejoin='round'
    >
      <path d='M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4'></path>
      <polyline points='7 10 12 15 17 10'></polyline>
      <line x1='12' y1='15' x2='12' y2='3'></line>
    </svg>
    Download CV (PDF)
  </a>
  <div class='timeline'>
    {
      experience.map((job) => (
        <article class='timeline-experience-item'>
          <div class='timeline-experience-header'>
            <h3>{job.role}</h3>
            <span class='period'>{job.period}</span>
          </div>
          <p class='subtitle'>{job.company}</p>
          {job.projects && <p class='projects'>{job.projects}</p>}
          <p class='description'>{job.description}</p>
        </article>
      ))
    }
  </div>
</section>
